# ==============================================================================
# VELTRIX TECH - CONFIGURATION DES VARIABLES D'ENVIRONNEMENT (.env.example)
# Dupliquez ce fichier en '.env' pour le développement local.
# Pour la production, renseignez ces variables dans les paramètres de votre hébergeur (Vercel, etc.).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Authentification Google / Apple & Base de Données)
# Obtenez ces valeurs sur : https://app.supabase.com/project/_/settings/api
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-public-key

# Clé secrète de service Supabase (UNIQUEMENT côté serveur pour gestion des commandes sécurisées)
# Obtenez-la dans : Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------------
# 2. STRIPE (Paiements par Carte Bancaire Visa/Mastercard & Apple Pay)
# Obtenez ces clés sur : https://dashboard.stripe.com/apikeys
# ------------------------------------------------------------------------------
# Clé publique Stripe (utilisée côté client pour Stripe Elements & Apple Pay)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Clé secrète Stripe (utilisée UNIQUEMENT côté serveur pour créer les PaymentIntents)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Secret de signature du Webhook Stripe (obtenu lors de la création du webhook / stripe listen)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# ------------------------------------------------------------------------------
# 3. PAYPAL CHECKOUT (SDK Officiel REST API v2)
# Obtenez ces identifiants sur : https://developer.paypal.com/dashboard/applications
# ------------------------------------------------------------------------------
# Client ID PayPal (utilisé côté client pour afficher le bouton et côté serveur)
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Clé secrète PayPal (utilisée UNIQUEMENT côté serveur pour capturer les paiements)
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# Mode PayPal : 'sandbox' pour les tests, 'live' pour la production
PAYPAL_MODE=sandbox

# Devise de règlement PayPal (Par défaut 'EUR' pour les comptes PayPal marocains/internationaux)
PAYPAL_CURRENCY=EUR

# ID du Webhook PayPal (obtenu dans le Dashboard Développeur PayPal > Webhooks)
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# ------------------------------------------------------------------------------
# 4. CONFIGURATION DE L'APPLICATION & REDIRECTIONS OAUTH
# ------------------------------------------------------------------------------
APP_URL=http://localhost:5173
